{
  "name": "@cahgnexx/ghx",
  "version": "0.1.1",
  "description": "A secure GitHub account manager and clone CLI",
  "type": "module",
  "bin": {
    "ghx": "./dist/bin/ghx.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/bin/ghx.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "github",
    "git",
    "keychain",
    "multi-account",
    "clone",
    "security"
  ],
  "author": "Kane Le <cuonglvrepvn@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.1.0",
    "@napi-rs/keyring": "^2.1.1",
    "commander": "^13.0.0",
    "ini": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.7.5",
    "eslint": "^10.13.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanelv/ghx.git"
  },
  "homepage": "https://github.com/kanelv/ghx#readme",
  "bugs": {
    "url": "https://github.com/kanelv/ghx/issues"
  }
}
