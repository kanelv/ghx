{
  "name": "ghx",
  "version": "0.1.0",
  "description": "A secure GitHub account manager and clone CLI",
  "type": "module",
  "bin": {
    "ghx": "./dist/bin/ghx.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "github",
    "git",
    "keychain",
    "multi-account",
    "clone",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.1.0",
    "@napi-rs/keyring": "^2.1.1",
    "commander": "^13.0.0",
    "ini": "^5.0.0"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/node": "^22.7.5",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
